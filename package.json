{
  "name": "popuploom",
  "version": "2.0.0",
  "description": "PopupLoom: free website popup builder with a visual editor, templates, hosted embeds and lead capture",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/regression.test.cjs tests/password-reset.test.cjs",
    "dev:cf": "wrangler dev",
    "deploy:cf": "node scripts/check-cf.cjs && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply popforge --local",
    "db:export": "node scripts/export-db.js",
    "test:cf": "node --test tests/cf-unit.test.cjs",
    "test:cf:integration": "wrangler deploy --dry-run --outdir .cf-build && node tests/cf-integration.cjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "google-auth-library": "^11.3.2",
    "jose": "^6.2.14",
    "jsonwebtoken": "^9.0.2"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "puppeteer-core": "^25.16.0",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
