# Copy to .env and fill in. The server loads this file on boot.
# Node reads it with process.loadEnvFile (Node 20.12+), no dotenv package needed.

# HTTP port
PORT=3000

# Sign login tokens. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Google sign-in. From Google Cloud Console → APIs & Services → Credentials
# → OAuth client ID → Web application. See README for the full walkthrough.
GOOGLE_CLIENT_ID=

# Optional: override the SQLite location.
# The default filename keeps the original project identifier; it is not visible branding.
# DB_PATH=./popuploom.db

# Optional: comma-separated trusted reverse proxy IPs/subnets. Default: no proxy trust.
# TRUST_PROXY=127.0.0.1,::1

# Optional additional browser frontend origins allowed to use private APIs (comma-separated).
# APP_ORIGINS=https://studio.example.com

# ---- Password reset email ----
# Resend (https://resend.com) is the default adapter: no SDK, the server calls
# https://api.resend.com/emails with fetch. Free plan: 3,000 emails/month and
# 100/day. Verify popuploom.com in Resend (SPF + DKIM) before production use.
# Leave RESEND_API_KEY empty to disable reset email; the reset endpoints then
# answer 503 with a clear setup message instead of failing mid-request.
RESEND_API_KEY=

# Verified sender. Use the domain you verified in Resend, not a personal inbox.
RESET_EMAIL_FROM="PopupLoom <reset@popuploom.com>"

# Public origin used to build reset and verification links. Must be HTTPS in production.
# http://localhost is accepted for local development only.
PUBLIC_ORIGIN=http://localhost:3000

# New password accounts must confirm their email before the first sign-in.
# Enables the F-15 enumeration fix. Requires working RESEND settings.
REQUIRE_EMAIL_VERIFICATION=true

# Local webhook testing only. Leave false in production; enabling it permits
# plain HTTP webhook URLs and loopback receivers.
ALLOW_INSECURE_WEBHOOKS=false

# ---- Advertising (live; see shared/ad-pages.js for the allowlist) ----
# Ads serve on public content pages only. Keep these gates accurate: the build
# fails if ADSENSE_ENABLED=true is combined with a missing client, slot,
# approval or CMP value.
ADSENSE_ENABLED=true
# Set only while Google's account UI shows the site as Ready/approved.
ADSENSE_APPROVED=true
ADSENSE_CLIENT=
ADSENSE_CMP=
# Google Privacy & messaging CMP identifier used by this implementation.
# ADSENSE_CMP=google-privacy-messaging
# Real ad unit slot ID(s). A single slot can be supplied with ADSENSE_SLOT.
# Multiple units can be supplied as JSON, e.g. {"default":"1234567890"}.
ADSENSE_SLOT=
ADSENSE_SLOTS=
# Real publisher ID only, for example pub-0000000000000000.
ADSENSE_PUBLISHER_ID=
