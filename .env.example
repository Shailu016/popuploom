# Copy to .env and fill in. The server loads this file on boot.
# Node reads it with process.loadEnvFile (Node 20.12+), no dotenv package needed.

# HTTP port
PORT=3000

# Sign login tokens. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Google sign-in. From Google Cloud Console → APIs & Services → Credentials
# → OAuth client ID → Web application. See README for the full walkthrough.
GOOGLE_CLIENT_ID=

# Optional: override the SQLite location
# DB_PATH=./popforge.db

# Optional: comma-separated trusted reverse proxy IPs/subnets. Default: no proxy trust.
# TRUST_PROXY=127.0.0.1,::1

# Optional additional browser frontend origins allowed to use private APIs (comma-separated).
# APP_ORIGINS=https://studio.example.com
